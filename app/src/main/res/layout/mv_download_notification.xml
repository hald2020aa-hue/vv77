<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:layoutDirection="locale" android:padding="10dp"
    android:background="@drawable/mv_notification_panel">
    <TextView android:id="@+id/mv_notification_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="start" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"
        android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/mv_notification_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="start" android:layout_marginTop="3dp" android:drawableStart="@drawable/mv_notification_ic_download"
        android:drawablePadding="5dp" android:textColor="#E3D9F5" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
    <LinearLayout android:id="@+id/mv_notification_progress_row" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="7dp">
        <TextView android:id="@+id/mv_notification_percent" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/mv_notification_percent_chip" android:paddingStart="7dp" android:paddingEnd="7dp"
            android:paddingTop="3dp" android:paddingBottom="3dp" android:gravity="center" android:textColor="#79F7FF"
            android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <ProgressBar android:id="@+id/mv_notification_progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="12dp" android:layout_marginStart="7dp"
            android:layoutDirection="ltr" android:max="100" android:progressDrawable="@drawable/mv_notification_progress"
            android:progressTint="@null" android:progressBackgroundTint="@null" android:secondaryProgressTint="@null" android:indeterminateTint="#19E6FF"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/mv_notification_stats" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="5dp">
        <TextView android:id="@+id/mv_notification_speed" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:drawableStart="@drawable/mv_notification_ic_speed" android:drawablePadding="4dp" android:gravity="start"
            android:textColor="#F5D8FF" android:textSize="11sp" android:maxLines="2" android:ellipsize="end"/>
        <TextView android:id="@+id/mv_notification_bytes" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="4dp" android:drawableStart="@drawable/mv_notification_ic_download" android:drawablePadding="4dp"
            android:gravity="start" android:textColor="#D5F5FF" android:textSize="11sp" android:maxLines="2" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginTop="7dp" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/mv_notification_primary" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content"
            android:minHeight="48dp" android:background="@drawable/mv_notification_primary_action" android:orientation="horizontal" android:gravity="center"
            android:paddingStart="5dp" android:paddingEnd="5dp" android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/mv_notification_primary_icon" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/mv_notification_ic_pause" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/mv_notification_primary_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp"
                android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:gravity="center" android:maxLines="2"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/mv_notification_manage" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:minHeight="48dp" android:layout_marginStart="7dp" android:background="@drawable/mv_notification_secondary_action" android:orientation="horizontal"
            android:gravity="center" android:paddingStart="5dp" android:paddingEnd="5dp" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/mv_notification_ic_manage" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/mv_notification_manage_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp"
                android:textColor="#E5F2FF" android:textSize="12sp" android:textStyle="bold" android:gravity="center" android:maxLines="2"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
