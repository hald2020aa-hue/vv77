<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/title"
        style="?textAppearanceTitleSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="9dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/v22_card"
        android:paddingStart="14dp"
        android:paddingTop="4dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp"
        android:textColor="@color/v22_text"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        tools:text="Sources"  android:minHeight="42dp" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_browse_outline_24dp" android:drawablePadding="8dp"/>

</FrameLayout>
