<?xml version='1.0' encoding='UTF-8'?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/recents_layout" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/v22_screen_bg">

    <com.google.android.material.loadingindicator.LoadingIndicator android:id="@+id/progress" app:indicatorSize="75dp" android:layout_width="75dp" android:layout_height="75dp" android:layout_gravity="center"/>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/swipe_refresh" android:layout_width="match_parent" android:layout_height="match_parent">

        <FrameLayout android:id="@+id/recents_frame_layout" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/v22_screen_bg">

            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:background="@drawable/v22_screen_bg" tools:listitem="@layout/recent_manga_item"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/recents_summary"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:layout_gravity="top"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:visibility="gone"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/v22_card_flat"
                app:strokeColor="@color/v22_stroke"
                app:strokeWidth="1.4dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                    <ImageView android:layout_width="220dp" android:layout_height="match_parent" android:layout_gravity="end" android:scaleType="centerCrop" android:src="@drawable/v22_banner_art" android:importantForAccessibility="no" />
                    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/v22_scrim_start" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp">
                        <TextView
                            android:id="@+id/recents_summary_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/recent_updates_activity"
                            android:textColor="@color/v22_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/recents_summary_subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/recent_updates_subtitle"
                            android:textColor="@color/v22_muted"
                            android:textSize="10sp"
                            android:maxLines="1" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:layout_marginTop="5dp"
                            android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/v22_tile_violet" android:gravity="center" android:orientation="vertical">
                            <TextView android:id="@+id/recents_summary_chapters" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/v22_text" android:textSize="17sp" android:textStyle="bold" />
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                                <ImageView android:layout_width="11dp" android:layout_height="11dp" android:layout_marginEnd="3dp" android:src="@drawable/ic_book_open_variant_24dp" app:tint="@color/v22_purple" android:importantForAccessibility="no" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/chapters" android:textColor="@color/v22_text_soft" android:textSize="9sp" android:maxLines="1" />
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/v22_tile_cyan" android:gravity="center" android:orientation="vertical">
                            <TextView android:id="@+id/recents_summary_titles" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/v22_text" android:textSize="17sp" android:textStyle="bold" />
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                                <ImageView android:layout_width="11dp" android:layout_height="11dp" android:layout_marginEnd="3dp" android:src="@drawable/ic_bookmark_24dp" app:tint="@color/v22_cyan" android:importantForAccessibility="no" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/library" android:textColor="@color/v22_text_soft" android:textSize="9sp" android:maxLines="1" />
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/v22_tile_green" android:gravity="center" android:orientation="vertical">
                            <TextView android:id="@+id/recents_summary_downloaded" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/v22_text" android:textSize="17sp" android:textStyle="bold" />
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                                <ImageView android:layout_width="11dp" android:layout_height="11dp" android:layout_marginEnd="3dp" android:src="@drawable/ic_file_download_24dp" app:tint="@color/v22_green" android:importantForAccessibility="no" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/downloaded" android:textColor="@color/v22_text_soft" android:textSize="9sp" android:maxLines="1" />
                            </LinearLayout>
                        </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <eu.kanade.tachiyomi.widget.EmptyView android:id="@+id/recents_empty_view" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:visibility="gone"/>

    <!-- Adding bottom sheet after main content -->
    <include layout="@layout/download_bottom_sheet" android:id="@+id/download_bottom_sheet"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
