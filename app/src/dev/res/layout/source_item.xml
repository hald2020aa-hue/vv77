<?xml version='1.0' encoding='utf-8'?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/end_view"
        style="@style/Widget.Tachiyomi.CardView.Container"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:cardBackgroundColor="@color/material_red_500">
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/close_right"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end|center"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:text="@string/hide"
            android:textColor="@color/md_white_1000" />
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/start_view"
        style="@style/Widget.Tachiyomi.CardView.Container"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:cardBackgroundColor="@color/material_red_500">
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/close_left"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start|center"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:text="@string/hide"
            android:textColor="@color/md_white_1000" />
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/source_card"
        style="@style/Widget.Tachiyomi.CardView.Container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="5dp"
        app:cardBackgroundColor="@color/v22_card_flat"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/v22_stroke"
        app:strokeWidth="1.2dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/v22_card_flat"
            android:minHeight="68dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/source_pin"
                style="?materialIconButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/pin"
                app:icon="@drawable/ic_pin_24dp"
                app:iconSize="20dp"
                app:iconTint="@color/v22_purple"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
            <ImageView
                android:id="@+id/source_image"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="3dp"
                android:scaleType="fitCenter"
                tools:src="@mipmap/ic_launcher_round"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="2"
                android:textColor="@color/v22_text"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Manga source"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                app:layout_constraintStart_toEndOf="@id/source_image"
                app:layout_constraintEnd_toStartOf="@id/source_divider" />
            <View
                android:id="@+id/source_divider"
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="@drawable/v22_divider"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginEnd="4dp"
                app:layout_constraintEnd_toStartOf="@id/source_latest" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/source_latest"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.0"
                android:minWidth="0dp"
                android:text="@string/latest"
                android:textAllCaps="false"
                android:textColor="@color/v22_cyan"
                android:textSize="12sp"
                app:backgroundTint="@color/v22_card_flat"
                app:cornerRadius="16dp"
                app:iconTint="@color/v22_cyan"
                app:strokeColor="@color/v22_cyan_soft"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:minHeight="48dp"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:maxLines="2"
                android:ellipsize="end"
                app:layout_constraintEnd_toStartOf="@id/source_pin" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
