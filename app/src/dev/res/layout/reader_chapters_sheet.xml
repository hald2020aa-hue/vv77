<?xml version='1.0' encoding='UTF-8'?>
<eu.kanade.tachiyomi.ui.reader.chapter.ReaderChapterSheet xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/chapters_bottom_sheet" android:layout_width="match_parent" android:layout_height="300dp" android:background="@drawable/v21_reader_panel" android:orientation="vertical" app:behavior_peekHeight="68dp" app:layout_behavior="eu.kanade.tachiyomi.ui.reader.chapter.ReaderChapterSheetBehavior" android:paddingBottom="12dp">

    <FrameLayout android:id="@+id/topbar_layout" android:layout_width="match_parent" android:layout_height="64dp" android:clickable="true" android:focusable="false" android:descendantFocusability="afterDescendants" android:paddingTop="3dp">

        <ImageView android:id="@+id/pill" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:alpha="0.25" android:contentDescription="@string/drag_handle" android:src="@drawable/draggable_pill" android:layout_gravity="top|center" app:tint="?actionBarTintColor"/>

        <LinearLayout android:id="@+id/buttonGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:spacing="0dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/chapters_button" style="@style/Widget.Tachiyomi.Button.ReaderIcon" app:icon="@drawable/ic_format_list_numbered_24dp" android:contentDescription="@string/view_chapters" android:text="@string/view_chapters" android:textSize="10sp" android:maxLines="2" android:ellipsize="end" android:paddingStart="2dp" android:paddingEnd="2dp" android:paddingTop="7dp" android:paddingBottom="2dp" android:minHeight="48dp" app:iconGravity="textTop" app:iconPadding="2dp" android:tooltipText="@string/view_chapters"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/webview_button" style="@style/Widget.Tachiyomi.Button.ReaderIcon" app:icon="@drawable/ic_open_in_webview_24dp" android:contentDescription="@string/open_in_webview" android:text="@string/open_in_webview" android:textSize="10sp" android:maxLines="2" android:ellipsize="end" android:paddingStart="2dp" android:paddingEnd="2dp" android:paddingTop="7dp" android:paddingBottom="2dp" android:minHeight="48dp" app:iconGravity="textTop" app:iconPadding="2dp" android:tooltipText="@string/open_in_webview"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/reading_mode" style="@style/Widget.Tachiyomi.Button.ReaderIcon" app:icon="@drawable/ic_reader_default_24dp" android:contentDescription="@string/reading_mode" android:text="@string/reading_mode" android:textSize="10sp" android:maxLines="2" android:ellipsize="end" android:paddingStart="2dp" android:paddingEnd="2dp" android:paddingTop="7dp" android:paddingBottom="2dp" android:minHeight="48dp" app:iconGravity="textTop" app:iconPadding="2dp" android:tooltipText="@string/reading_mode"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/rotation_sheet_button" style="@style/Widget.Tachiyomi.Button.ReaderIcon" app:icon="@drawable/ic_screen_rotation_24dp" android:contentDescription="@string/rotation" android:text="@string/rotation" android:textSize="10sp" android:maxLines="2" android:ellipsize="end" android:paddingStart="2dp" android:paddingEnd="2dp" android:paddingTop="7dp" android:paddingBottom="2dp" android:minHeight="48dp" app:iconGravity="textTop" app:iconPadding="2dp" android:tooltipText="@string/rotation" android:visibility="gone" tools:visibility="visible"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/crop_borders_sheet_button" style="@style/Widget.Tachiyomi.Button.ReaderIcon" app:icon="@drawable/anim_crop_to_free" android:contentDescription="@string/crop_borders" android:text="@string/crop_borders" android:textSize="10sp" android:maxLines="2" android:ellipsize="end" android:paddingStart="2dp" android:paddingEnd="2dp" android:paddingTop="7dp" android:paddingBottom="2dp" android:minHeight="48dp" app:iconGravity="textTop" app:iconPadding="2dp" android:tooltipText="@string/crop_borders" android:visibility="gone" tools:visibility="visible"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/double_page" style="@style/Widget.Tachiyomi.Button.ReaderIcon" app:icon="@drawable/ic_book_open_variant_24dp" android:contentDescription="@string/page_layout" android:text="@string/page_layout" android:textSize="10sp" android:maxLines="2" android:ellipsize="end" android:paddingStart="2dp" android:paddingEnd="2dp" android:paddingTop="7dp" android:paddingBottom="2dp" android:minHeight="48dp" app:iconGravity="textTop" app:iconPadding="2dp" android:tooltipText="@string/page_layout"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/shift_page_button" style="@style/Widget.Tachiyomi.Button.ReaderIcon" app:icon="@drawable/ic_page_next_outline_24dp" android:contentDescription="@string/shift_one_page_over" android:text="@string/shift_one_page_over" android:textSize="10sp" android:maxLines="2" android:ellipsize="end" android:paddingStart="2dp" android:paddingEnd="2dp" android:paddingTop="7dp" android:paddingBottom="2dp" android:minHeight="48dp" app:iconGravity="textTop" app:iconPadding="2dp" android:tooltipText="@string/shift_one_page_over"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/display_options" style="@style/Widget.Tachiyomi.Button.ReaderIcon" app:icon="@drawable/ic_tune_24dp" android:contentDescription="@string/display_options" android:text="@string/display_options" android:textSize="10sp" android:maxLines="2" android:ellipsize="end" android:paddingStart="2dp" android:paddingEnd="2dp" android:paddingTop="7dp" android:paddingBottom="2dp" android:minHeight="48dp" app:iconGravity="textTop" app:iconPadding="2dp" android:tooltipText="@string/display_options"/>
        </LinearLayout>
    </FrameLayout>

    <eu.kanade.tachiyomi.ui.reader.chapter.ChapterRecyclerView android:id="@+id/chapter_recycler" android:layout_width="match_parent" android:layout_height="match_parent" android:focusable="true" android:alpha="0" android:background="@android:color/transparent" android:clipToPadding="false" tools:listitem="@layout/reader_chapter_item"/>
</eu.kanade.tachiyomi.ui.reader.chapter.ReaderChapterSheet>
