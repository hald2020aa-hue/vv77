<?xml version='1.0' encoding='UTF-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/main_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/v22_screen_bg">

    <com.bluelinelabs.conductor.ChangeHandlerFrameLayout android:id="@+id/controller_container" android:layout_width="match_parent" android:layout_height="match_parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintHorizontal_bias="1.0" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintVertical_bias="0.0">

        <ImageView android:id="@+id/back_shadow" android:layout_width="6dp" android:alpha="0.25" android:visibility="gone" android:layout_height="match_parent" android:src="@drawable/shape_gradient_start_shadow" android:importantForAccessibility="no"/>
    </com.bluelinelabs.conductor.ChangeHandlerFrameLayout>

    <View android:id="@+id/status_bar" android:layout_width="0dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_height="0dp"/>

    <eu.kanade.tachiyomi.ui.base.ExpandedAppBarLayout android:id="@+id/app_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:stateListAnimator="@null" android:elevation="0dp" app:layout_constraintLeft_toLeftOf="parent" app:layout_constraintRight_toRightOf="parent" app:layout_constraintTop_toTopOf="parent" android:background="@color/v22_bg">

        <!-- V22: the toolbar keeps its id/type; the neon logo row is an overlay sibling inside the same frame. -->
        <FrameLayout android:id="@+id/v22_header_row" android:layout_width="match_parent" android:layout_height="wrap_content">

            <eu.kanade.tachiyomi.ui.base.CenteredToolbar app:popupTheme="@style/ThemeOverlay.J2K.NeonReaderPopup" android:id="@+id/toolbar" android:layout_width="match_parent" app:titleTextColor="?actionBarTintColor" android:layout_height="?mainActionBarSize" android:translationZ="5dp" android:outlineProvider="none" app:collapseIcon="@drawable/ic_arrow_back_24dp" android:background="@android:color/transparent">

                <com.google.android.material.textview.MaterialTextView android:id="@+id/toolbar_title" style="?textAppearanceTitleLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:drawableTint="?actionBarTintColor" android:ellipsize="end" android:layout_gravity="center" android:maxLines="1" android:textColor="@color/v22_text" android:textSize="20sp" android:textStyle="bold" tools:text="Title Text"/>
            </eu.kanade.tachiyomi.ui.base.CenteredToolbar>

            <FrameLayout android:id="@+id/v22_header_chrome" android:layout_width="match_parent" android:layout_height="?mainActionBarSize" android:translationZ="6dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:clipChildren="false">

                <LinearLayout android:id="@+id/v22_header_actions" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="start|center_vertical" android:gravity="center_vertical" android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView android:id="@+id/v22_header_avatar" android:layout_width="40dp" android:layout_height="40dp" android:padding="3dp" android:background="@drawable/v22_avatar_ring" android:src="@mipmap/ic_launcher" android:scaleType="centerCrop" app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full" android:contentDescription="@string/settings" android:clickable="true" android:focusable="true"/>

                    <View android:layout_width="1dp" android:layout_height="22dp" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:background="#55A14BFF"/>

                    <FrameLayout android:layout_width="40dp" android:layout_height="40dp">
                        <ImageView android:id="@+id/v22_header_bell" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:background="@drawable/v22_icon_button" android:src="@drawable/v22_ic_bell" android:contentDescription="@string/updates" android:clickable="true" android:focusable="true"/>
                        <View android:layout_width="9dp" android:layout_height="9dp" android:layout_gravity="top|end" android:layout_marginTop="5dp" android:layout_marginEnd="5dp" android:background="@drawable/v22_nav_dot" android:importantForAccessibility="no"/>
                    </FrameLayout>

                    <ImageView android:id="@+id/v22_header_search" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:padding="9dp" android:background="@drawable/v22_icon_button" android:src="@drawable/v14_icon_search" android:contentDescription="@string/search" android:clickable="true" android:focusable="true"/>
                </LinearLayout>

                <ImageView android:id="@+id/v22_header_logo" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_gravity="end|center_vertical" android:adjustViewBounds="true" android:scaleType="fitCenter" android:src="@drawable/v22_logo_lockup" android:contentDescription="@string/app_name"/>
            </FrameLayout>
        </FrameLayout>

        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/big_toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginTop="2dp" android:layout_marginBottom="8dp" android:minHeight="72dp" android:background="@drawable/v22_banner_frame" android:padding="2dp" android:layoutDirection="ltr">

            <com.google.android.material.card.MaterialCardView android:id="@+id/v22_banner_card" android:layout_width="0dp" android:layout_height="0dp" app:cardBackgroundColor="@android:color/transparent" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
<ImageView android:id="@+id/v22_banner_art" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/v22_banner_art" android:importantForAccessibility="no"/>
<View android:id="@+id/v22_banner_scrim" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/v22_scrim_start"/>
</com.google.android.material.card.MaterialCardView>
<FrameLayout android:id="@+id/big_icon_layout" android:visibility="gone" tools:visibility="visible" android:layout_width="48dp" android:layout_height="0dp" app:layout_constraintHeight_min="wrap" app:layout_constraintVertical_bias="0.5" android:layout_marginStart="12dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent">
                <androidx.appcompat.widget.AppCompatImageView android:id="@+id/big_icon" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center" tools:srcCompat="@mipmap/ic_launcher"/>
            </FrameLayout>

            <com.google.android.material.textview.MaterialTextView android:id="@+id/big_title" android:paddingStart="10dp" android:paddingEnd="10dp" style="?textAppearanceHeadlineLarge" android:textStyle="bold" android:layout_width="0dp" android:maxLines="2" android:layout_marginTop="12dp" app:layout_constraintTop_toTopOf="parent" android:layout_height="wrap_content" app:layout_constraintStart_toEndOf="@id/big_icon_layout" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toTopOf="@id/enhanced_header_subtitle" app:layout_constraintVertical_chainStyle="packed" android:drawableTint="?actionBarTintColor" android:ellipsize="end" android:layout_gravity="start" android:textColor="@color/v22_text" tools:text="Big Title" android:background="@android:color/transparent" android:paddingTop="2dp" android:paddingBottom="0dp" android:gravity="start|center_vertical" android:textSize="24sp" app:layout_constraintHorizontal_bias="0.0" app:layout_constraintWidth_percent="0.62"/>

            <com.google.android.material.textview.MaterialTextView android:id="@+id/enhanced_header_subtitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_marginBottom="12dp" android:text="@string/enhanced_header_tagline" android:textColor="@color/v22_text_soft" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" app:layout_constraintTop_toBottomOf="@id/big_title" app:layout_constraintStart_toStartOf="@id/big_title" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="@id/big_title" app:layout_constraintHorizontal_bias="0.0"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout android:id="@+id/card_frame" android:layout_width="match_parent" android:layout_height="?mainActionBarSize" android:paddingStart="14dp" android:paddingEnd="14dp" android:clipToPadding="false" android:orientation="horizontal">

            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:background="@drawable/v22_search_pill" android:padding="1.5dp" android:clipChildren="false"><com.google.android.material.card.MaterialCardView android:id="@+id/card_view" android:layout_width="match_parent" app:cardBackgroundColor="@android:color/transparent" app:strokeWidth="0dp" app:cardCornerRadius="22dp" app:cardElevation="0dp" android:layout_height="match_parent" app:strokeColor="@android:color/transparent">

                <eu.kanade.tachiyomi.ui.base.FloatingToolbar app:popupTheme="@style/ThemeOverlay.J2K.NeonReaderPopup" android:id="@+id/search_toolbar" tools:title="Search Library..." app:contentInsetStartWithNavigation="0dp" app:contentInsetEndWithActions="0dp" app:contentInsetStart="0dp" app:contentInsetEnd="0dp" android:background="@android:color/transparent" app:navigationIconTint="@color/v22_cyan" app:navigationIcon="@drawable/ic_search_24dp" app:titleTextAppearance="@style/TextAppearance.FloatingTitle" app:subtitleTextAppearance="?textAppearanceBodySmall" app:collapseIcon="@drawable/ic_arrow_back_24dp" android:layout_width="match_parent" android:layout_height="match_parent">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="start|center" android:orientation="horizontal">

                        <ImageView android:id="@+id/card_incog_image" app:tint="?actionBarTintColor" android:layout_gravity="center|start" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="6dp" android:layout_marginStart="0dp" android:contentDescription="@string/incognito_mode" android:src="@drawable/ic_incognito_circle_24dp"/>

                        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="start|center" android:orientation="vertical">
                            <com.google.android.material.textview.MaterialTextView android:id="@+id/card_title" style="?textAppearanceTitleLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:drawableTint="?actionBarTintColor" android:ellipsize="end" android:layout_gravity="center" android:maxLines="1" android:textColor="@color/v22_text" android:textSize="16sp" tools:drawableEnd="@drawable/ic_arrow_drop_down_24dp" tools:drawableStart="@drawable/ic_blank_24dp" tools:text="Title Text" android:background="@android:color/transparent"/>

                            <com.google.android.material.textview.MaterialTextView android:id="@+id/card_subtitle" style="?textAppearanceTitleLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:layout_gravity="start|center" android:maxLines="1" android:textColor="@color/v22_muted" android:textSize="12sp" tools:text="Title Text" android:background="@android:color/transparent"/>
                        </LinearLayout>
                    </LinearLayout>
                </eu.kanade.tachiyomi.ui.base.FloatingToolbar>
            </com.google.android.material.card.MaterialCardView>

            </FrameLayout><com.google.android.material.button.MaterialButton android:id="@+id/toolbar_filter_button" style="@style/Widget.Tachiyomi.Button.IconButton.ToolbarFilled" android:layout_width="?mainActionBarSize" android:layout_marginStart="8dp" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:contentDescription="@string/filter" android:visibility="gone" android:tooltipText="@string/search_filters" tools:visibility="visible" android:layout_height="match_parent" app:icon="@drawable/ic_filter_alt_24dp" app:iconTint="@color/v22_cyan" app:backgroundTint="@color/v22_card_flat" app:strokeColor="@color/v22_stroke" app:strokeWidth="1.2dp" app:cornerRadius="16dp"/>
        </LinearLayout>

        <FrameLayout android:id="@+id/tabs_frame_layout" android:clickable="true" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" tools:ignore="KeyboardInaccessibleWidget">
            <com.google.android.material.tabs.TabLayout android:id="@+id/main_tabs" style="@style/Theme.Widget.Tabs.Highlight" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:tabGravity="fill"/>
        </FrameLayout>
    </eu.kanade.tachiyomi.ui.base.ExpandedAppBarLayout>

    <View android:id="@+id/bottom_view" android:clickable="true" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintLeft_toLeftOf="parent" app:layout_constraintRight_toRightOf="parent" android:layout_width="match_parent" android:visibility="gone" android:layout_height="0dp" tools:ignore="KeyboardInaccessibleWidget"/>

    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottom_nav" android:layout_width="match_parent" android:layout_height="wrap_content" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintLeft_toLeftOf="parent" app:layout_constraintRight_toRightOf="parent" app:menu="@menu/bottom_navigation" android:background="@drawable/v22_bottom_nav" android:elevation="8dp" app:labelVisibilityMode="labeled" android:paddingStart="14dp" android:paddingEnd="14dp" app:itemIconTint="@color/v22_nav_tint" app:itemTextColor="@color/v22_nav_tint" app:itemBackground="@drawable/v22_nav_item_bg" app:itemActiveIndicatorStyle="@style/V22.NavIndicator" android:backgroundTint="@null" android:paddingTop="0dp" android:paddingBottom="8dp"/>

    <View android:id="@+id/action_mode_status_bar" android:layout_width="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_height="0dp"/>

    <View android:id="@+id/nav_bar" android:layout_width="0dp" android:translationZ="100dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_height="0dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
